rules_version = '2';

// Botly Cloud Inbox + Bot Registry — see ADMIN_SETUP.md.
// Admin: muindidiego@gmail.com (add more emails inside the
// brackets below + mirror them in admin.html -> ADMIN_EMAILS).
// Deploy: Firebase console -> Firestore Database -> Rules -> paste -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['muindidiego@gmail.com'];
    }

    // Landing/contact chatbot inquiries. Visitors are NOT signed in, so
    // anyone may CREATE a lead (field-validated); only admins may read,
    // triage or delete.
    function validLead() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'leadId', 'botId', 'botName', 'company', 'name', 'phone', 'email',
        'need', 'goal', 'status', 'transcript', 'pageUrl', 'createdAt', 'payment'
      ])
        && d.name is string && d.name.size() <= 120
        && d.phone is string && d.phone.size() <= 40
        && d.email is string && d.email.size() <= 120
        && d.need is string && d.need.size() <= 1200;
    }

    match /botly_leads/{leadId} {
      allow create: if validLead();
      allow read, update, delete: if isAdmin();
    }

    // Studio bot registry (summaries only, no knowledge content).
    // Signed-in owners write their own rows; admins read everything.
    // Activation is AUDIT-MODEL: owners may flip their own bot `active`
    // false->true ONLY from the IntaSend return page (/activated), which
    // stamps activationSource='intasend_return' plus a FRESH
    // activationRef (the IntaSend reference when the redirect carries
    // one). Every activation emails the admin and files a `paid` claim,
    // and the admin revokes bogus ones in one click — direct console
    // writes without a fresh ref still fail.
    match /botly_bots/{docId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('active', false) == false;
      allow update: if isAdmin() || (request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['active'])
          || request.resource.data.get('active', false) == resource.data.get('active', false)
          || (resource.data.get('active', false) == false
            && request.resource.data.get('active', false) == true
            && request.resource.data.get('activationSource', '') == 'intasend_return'
            && request.resource.data.get('activationRef', '') is string
            && request.resource.data.get('activationRef', '').size() >= 6
            && request.resource.data.get('activationRef', '') != resource.data.get('activationRef', ''))));
      allow read: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Activation claims. Owners file + read their own claims. `pending`
    // rows are legacy/manual; `paid` rows are filed by /activated after
    // an IntaSend return (always with the activationRef). Admins triage:
    // Verify confirms, Deactivate/Reject revokes the license.
    match /botly_payments/{claimId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && (request.resource.data.status == 'pending'
          || (request.resource.data.status == 'paid'
            && request.resource.data.activationRef is string
            && request.resource.data.activationRef.size() >= 6));
      allow read: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // PUBLIC license registry — read by every bot embed at load time
    // to prove activation (see dist P96). Docs are keyed by plain botId.
    // Admins write freely; owners may write ONLY their own bot's license
    // (ownerUid+botId pinned, domains capped) — the /activated return
    // page uses this path, and every activation is audit-mailed.
    match /botly_licenses/{botId} {
      allow read: if true;
      allow create: if isAdmin() || (request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.botId == botId
        && request.resource.data.active is bool
        && (!request.resource.data.keys().hasAny(['domains'])
          || (request.resource.data.domains is list && request.resource.data.domains.size() <= 5)));
      allow update: if isAdmin() || (request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.botId == botId
        && request.resource.data.active is bool
        && (!request.resource.data.keys().hasAny(['domains'])
          || (request.resource.data.domains is list && request.resource.data.domains.size() <= 5)));
      allow delete: if isAdmin();
    }

    // PUBLISHED live configs — read by every paid embed at load time
    // (see dist P99: cloud wins when newer, inline snippet is fallback).
    // Owners publish/overwrite ONLY their own bot's doc. Public read is
    // safe: the same content already ships inline in the snippet, and
    // only LICENSED domains can run it.
    match /botly_configs/{botId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.botId == botId;
      allow update, delete: if isAdmin() || (request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid);
    }

    // First-come payment-reference registry: one IntaSend reference can
    // activate exactly one bot (create-only for owners; the doc id IS
    // the sanitized reference, so double-spends fail the batch).
    match /botly_refs/{ref} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.botId is string;
      allow read: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Admin notification outbox for the "Trigger Email from Firestore"
    // extension (watches `mail`; sends via the Admin SDK, bypassing
    // security rules). Fires when a Studio owner presses Pay so the
    // admin gets an instant email to verify in /admin -> Payments.
    //
    // Two valid shapes:
    //   (a) Signed-in owner (Pay button): { to, message, ownerUid, createdAt }
    //   (b) Anonymous visitor (lead/contact form): { to, message }
    // Both locked to muindidiego@gmail.com as the only recipient.
    // Shape (b) writers: contact.html form + dist lead sync (P100).
    function validMailBase() {
      let d = request.resource.data;
      return d.to == 'muindidiego@gmail.com'
        && d.message is map
        && d.message.keys().hasOnly(['subject', 'html'])
        && d.message.subject is string
        && d.message.subject.size() <= 200
        && d.message.html is string
        && d.message.html.size() <= 10000;
    }

    match /mail/{mailId} {
      // Signed-in owner pressing Pay: must include ownerUid + createdAt
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['to', 'message', 'ownerUid', 'createdAt'])
        && request.resource.data.ownerUid == request.auth.uid
        && validMailBase();

      // Anonymous visitor (contact/chatbot lead): to + message only
      allow create: if request.resource.data.keys().hasOnly(['to', 'message'])
        && validMailBase();


      allow read, update, delete: if isAdmin();
    }

    // Post-chat ratings from paid-bot embeds. Visitors are anonymous, so
    // anyone may CREATE a rating (field-validated, forced unapproved);
    // only APPROVED ratings are publicly readable (landing-page
    // testimonials); only admins triage.
    function validRating() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'botId', 'botName', 'company', 'rating', 'comment', 'name',
        'pageUrl', 'approved', 'createdAt'
      ])
        && d.botId is string && d.botId.size() <= 120
        && d.botName is string && d.botName.size() <= 120
        && d.company is string && d.company.size() <= 120
        && d.rating in ['up', 'down']
        && d.comment is string && d.comment.size() <= 600
        && d.name is string && d.name.size() <= 80
        && d.pageUrl is string && d.pageUrl.size() <= 300
        && d.approved == false
        && d.createdAt is timestamp;
    }

    match /botly_ratings/{ratingId} {
      allow create: if isAdmin() || resource.data.get('approved', false) == true;
      allow update, delete: if isAdmin();
    }
  }
}
