rules_version = '2';

// Botly Cloud Inbox + Bot Registry — see ADMIN_SETUP.md.
// Admin: muindidiego@gmail.com (add more emails inside the
// brackets below + mirror them in admin.html -> ADMIN_EMAILS).
// Deploy: Firebase console -> Firestore Database -> Rules -> paste -> Publish.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email in ['muindidiego@gmail.com'];
    }

    // Landing/contact chatbot inquiries. Visitors are NOT signed in, so
    // anyone may CREATE a lead (field-validated); only admins may read,
    // triage or delete.
    function validLead() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'leadId', 'botId', 'botName', 'company', 'name', 'phone', 'email',
        'need', 'goal', 'status', 'transcript', 'pageUrl', 'createdAt', 'payment'
      ])
        && d.name is string && d.name.size() <= 120
        && d.phone is string && d.phone.size() <= 40
        && d.email is string && d.email.size() <= 120
        && d.need is string && d.need.size() <= 1200;
    }

    match /botly_leads/{leadId} {
      allow create: if validLead();
      allow read, update, delete: if isAdmin();
    }

    // Studio bot registry (summaries only, no knowledge content).
    // Signed-in owners write their own rows; admins read everything.
    // VERIFY-ONLY activation: owners may NOT touch `active` at all —
    // only the admin Verify/Reject buttons flip it (the old
    // trust-first auto-claim hole is closed). Owner merge-writes that
    // don't include `active` (e.g. cloud sync) pass through untouched.
    match /botly_bots/{docId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.get('active', false) == false;
      allow update: if isAdmin() || (request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid
        && (!request.resource.data.keys().hasAny(['active'])
          || request.resource.data.get('active', false) == resource.data.get('active', false)));
      allow read: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow delete: if isAdmin();
    }

    // Activation claims. Owners file + read their own claims (filing
    // does NOT activate — the bot unlocks only when an admin presses
    // Verify); only admins triage — Verify activates + writes the
    // public license, while Reject deactivates + revokes the license.
    match /botly_payments/{claimId} {
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.status == 'pending';
      allow read: if isAdmin()
        || (request.auth != null && resource.data.ownerUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // PUBLIC license registry — read by every bot embed at load time
    // to prove activation (see dist P96). Docs are keyed by plain botId
    // (e.g. botly_licenses/bot_1727...) and written ONLY by the admin
    // Verify/Reject buttons (Verify writes domains[], Reject sets
    // active:false). Public read is safe: a license only unlocks the
    // domains listed in it, and the check key is the botId.
    match /botly_licenses/{botId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Admin notification outbox for the "Trigger Email from Firestore"
    // extension (watches `mail`; sends via the Admin SDK, bypassing
    // rules). Visitors (unauthenticated) and signed-in owners may CREATE
    // tightly-shaped mails to the fixed admin address only — no arbitrary
    // recipients, content sizes capped.
    function validMail() {
      let d = request.resource.data;
      return d.keys().hasOnly(['to', 'message'])
        && d.to == 'muindidiego@gmail.com'
        && d.message.keys().hasOnly(['subject', 'html'])
        && d.message.subject is string
        && d.message.subject.size() <= 160
        && d.message.html is string
        && d.message.html.size() <= 8000;
    }
    match /mail/{mailId} {
      allow create: if validMail();
      allow read, update, delete: if isAdmin();
    }

    // Post-chat ratings from paid-bot embeds. Visitors are anonymous, so
    // anyone may CREATE a rating (field-validated, forced unapproved);
    // only APPROVED ratings are publicly readable (landing-page
    // testimonials); only admins triage.
    function validRating() {
      let d = request.resource.data;
      return d.keys().hasOnly([
        'botId', 'botName', 'company', 'rating', 'comment', 'name',
        'pageUrl', 'approved', 'createdAt'
      ])
        && d.botId is string && d.botId.size() <= 120
        && d.botName is string && d.botName.size() <= 120
        && d.company is string && d.company.size() <= 120
        && d.rating in ['up', 'down']
        && d.comment is string && d.comment.size() <= 600
        && d.name is string && d.name.size() <= 80
        && d.pageUrl is string && d.pageUrl.size() <= 300
        && d.approved == false
        && d.createdAt is timestamp;
    }

    match /botly_ratings/{ratingId} {
      allow create: if validRating();
      allow read: if isAdmin() || resource.data.get('approved', false) == true;
      allow update, delete: if isAdmin();
    }
  }
}
